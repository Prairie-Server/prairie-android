require "base64"
require "fileutils"
require "tmpdir"

# Root-level Fastfile — Android lane for Google Play releases. Mirrors the
# structure of silo-apple's Fastfile:
#
#   android beta — build both App Bundles, upload to a Play testing track
#
# All identifying values come from environment variables or committed
# constants. Nothing secret is hardcoded — this file is safe to commit to a
# public repo.
#
# Unlike Apple (where TestFlight reviews per marketing version, so one
# version is reused across many builds), Play keys everything on versionCode
# and has no version/build split. The versionCode base is derived from the
# marketing version (major*1_000_000 + minor*1_000 + patch) and Gradle ships
# phone = base*2, TV = base*2+1 — so every Play release needs a new
# major.minor.patch version. Both artifacts always ship together: they share
# one applicationId, and a new track release supersedes the previous one, so
# releasing one artifact would drop the other from the track.

default_platform(:android)

PACKAGE_NAME = "org.siloserver.silo"
PHONE_AAB = File.expand_path("../androidApp/build/outputs/bundle/release/androidApp-release.aab", __dir__)
TV_AAB = File.expand_path("../androidTvApp/build/outputs/bundle/release/androidTvApp-release.aab", __dir__)

# ── Private helpers ──────────────────────────────────────────────────────────

# Loads the Play publisher service-account key.
#
# CI path:   raw JSON from the PLAY_SERVICE_ACCOUNT_JSON env var.
# Local path: read ~/.playstore/silo-play-publisher.json from disk.
#
# Same CI/local duality as silo-apple's setup_api_key.
def play_json_key_data
  raw = ENV["PLAY_SERVICE_ACCOUNT_JSON"].to_s
  return raw unless raw.strip.empty?

  key_path = File.expand_path("~/.playstore/silo-play-publisher.json")
  UI.user_error!(
    "Play service-account key not found at #{key_path}. " \
    "Either place the JSON key file there or set PLAY_SERVICE_ACCOUNT_JSON."
  ) unless File.exist?(key_path)
  File.read(key_path)
end

# Resolves and validates the marketing version, returning [version, base_code].
#
# Only a plain dotted version is accepted: the versionCode is derived from
# major.minor.patch, so a prerelease suffix (1.4.0-rc.1) would collide with
# the base version's code and Play would reject the upload. The value also
# flows into Gradle -P properties, so the strict format doubles as the last
# gate against shell/property injection (same threat model as silo-apple's
# marketing_version_xcarg).
def resolve_release_version
  version = ENV["SILO_VERSION_NAME"].to_s.strip
  UI.user_error!("SILO_VERSION_NAME must be set (e.g. 1.4.0)") if version.empty?

  unless version.match?(/\A\d+\.\d+\.\d+\z/)
    UI.user_error!(
      "Invalid SILO_VERSION_NAME #{version.inspect}; expected a plain dotted " \
      "version like 1.4.0. Prerelease suffixes are not supported for Play " \
      "releases because the versionCode is derived from major.minor.patch."
    )
  end

  major, minor, patch = version.split(".").map(&:to_i)
  if minor > 999 || patch > 999
    UI.user_error!(
      "minor and patch must each be < 1000 — the versionCode packs them into " \
      "three decimal digits each (base = major*1e6 + minor*1e3 + patch)."
    )
  end

  base_code = major * 1_000_000 + minor * 1_000 + patch
  UI.user_error!("Version code base must be positive (0.0.0 is not releasable).") unless base_code.positive?
  # Gradle additionally enforces base <= 1_049_999_999 so base*2+1 stays
  # under Play's 2_100_000_000 versionCode ceiling.

  [version, base_code]
end

def play_track
  track = ENV.fetch("PLAY_TRACK", "beta").strip.downcase
  track = "beta" if track.empty?
  unless %w[internal alpha beta production].include?(track)
    UI.user_error!(
      "Unsupported PLAY_TRACK=#{track.inspect}. " \
      "Use internal, alpha, beta, or production."
    )
  end
  track
end

# Resolves the release keystore for Gradle signing.
#
# CI path:   base64-decode SILO_RELEASE_KEYSTORE_B64 into a temp file.
# Local paths: an explicit SILO_RELEASE_KEYSTORE path, falling back to
#              ~/keystores/silo-android-release.jks.
def resolve_release_keystore
  b64 = ENV["SILO_RELEASE_KEYSTORE_B64"].to_s
  unless b64.strip.empty?
    keystore_path = File.join(Dir.mktmpdir("silo-release-keystore"), "silo-release.jks")
    File.binwrite(keystore_path, Base64.decode64(b64))
    return keystore_path
  end

  explicit = ENV["SILO_RELEASE_KEYSTORE"].to_s
  unless explicit.strip.empty?
    UI.user_error!("SILO_RELEASE_KEYSTORE points to #{explicit}, which does not exist.") unless File.exist?(explicit)
    return explicit
  end

  local = File.expand_path("~/keystores/silo-android-release.jks")
  return local if File.exist?(local)

  UI.user_error!(
    "No release keystore available. Set SILO_RELEASE_KEYSTORE_B64 (CI), " \
    "SILO_RELEASE_KEYSTORE (explicit path), or place the keystore at #{local}."
  )
end

# The keystore/key passwords and key alias are read by Gradle directly from
# the environment (see signingConfigs in the app build scripts); fail fast
# here so a missing secret surfaces before the ~10-minute bundle build.
# SILO_RELEASE_KEY_PASSWORD is optional — Gradle falls back to the keystore
# password when it is unset.
def require_signing_env!
  %w[SILO_RELEASE_KEYSTORE_PASSWORD SILO_RELEASE_KEY_ALIAS].each do |name|
    UI.user_error!("#{name} must be set for release signing.") if ENV[name].to_s.strip.empty?
  end
end

# FCM config for push notifications. The app degrades gracefully without it
# (push registration is skipped), but store builds should ship with push
# working. Encode with: base64 < androidApp/google-services.json | tr -d '\n'
def materialize_google_services_json
  target = File.expand_path("../androidApp/google-services.json", __dir__)
  return if File.exist?(target)

  b64 = ENV["SILO_GOOGLE_SERVICES_JSON_B64"].to_s
  if b64.strip.empty?
    UI.important(
      "androidApp/google-services.json is absent and SILO_GOOGLE_SERVICES_JSON_B64 " \
      "is not set — building without FCM push support."
    )
    return
  end

  File.binwrite(target, Base64.decode64(b64))
  UI.message("Wrote androidApp/google-services.json from SILO_GOOGLE_SERVICES_JSON_B64.")
end

# Play's "What's new" note (500-char limit), written to the supply metadata
# changelog that applies to every version code in the release (default.txt).
# Set PLAY_RELEASE_NOTES for an explicit note; falls back to the released
# commit's subject — same pattern as silo-apple's TESTFLIGHT_CHANGELOG.
def write_play_changelog
  notes = ENV["PLAY_RELEASE_NOTES"].to_s.strip
  notes = sh("git log -1 --pretty=format:%s", log: false).strip if notes.empty?
  notes = notes[0, 500]

  changelog_dir = File.expand_path("metadata/android/en-US/changelogs", __dir__)
  FileUtils.mkdir_p(changelog_dir)
  File.write(File.join(changelog_dir, "default.txt"), notes)
  notes
end

# ── Android ──────────────────────────────────────────────────────────────────

platform :android do
  desc "Build both App Bundles (phone + TV) and upload to a Google Play track"
  lane :beta do
    version, base_code = resolve_release_version
    track = play_track
    json_key = play_json_key_data
    require_signing_env!
    ENV["SILO_RELEASE_KEYSTORE"] = resolve_release_keystore
    materialize_google_services_json
    write_play_changelog

    UI.message(
      "Releasing Silo #{version} to the #{track} track " \
      "(base code #{base_code} → phone #{base_code * 2}, TV #{base_code * 2 + 1})"
    )

    # One invocation builds both bundles so shared modules compile once. Any
    # task name containing "bundle" also disables the sideload APK ABI splits
    # (see isBuildingBundle in the app build scripts) — the AABs do their own
    # per-ABI delivery. R8 mapping files are embedded in the bundles
    # (BUNDLE-METADATA), so Play picks up deobfuscation automatically.
    gradle(
      tasks: [":androidApp:bundleRelease", ":androidTvApp:bundleRelease"],
      properties: {
        "siloVersionName" => version,
        "siloVersionCode" => base_code,
      },
      system_properties: {
        "org.gradle.jvmargs" => "-Xmx4g -Dfile.encoding=UTF-8",
      },
      flags: "--max-workers=2",
    )

    [PHONE_AAB, TV_AAB].each do |aab|
      UI.user_error!("Expected App Bundle not found at #{aab}") unless File.exist?(aab)
    end

    # Both AABs go up in a single Play edit/release — phone and TV must ship
    # together (see the header comment). Listing metadata and imagery stay
    # managed in the Play Console; only the changelog is uploaded from here.
    # If Google rejects the edit with "changes cannot be sent for review
    # automatically", a manual review step is pending in the Play Console —
    # pass changes_not_sent_for_review: true temporarily and submit there.
    upload_to_play_store(
      package_name: PACKAGE_NAME,
      json_key_data: json_key,
      track: track,
      release_status: "completed",
      version_name: version,
      aab_paths: [PHONE_AAB, TV_AAB],
      # Belt-and-braces: never let a stale APK from the gradle lane context
      # conflict with the explicit aab_paths above.
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false,
      changes_not_sent_for_review: false,
      timeout: 900,
    )

    UI.success("Uploaded Silo #{version} (phone #{base_code * 2} + TV #{base_code * 2 + 1}) to the #{track} track.")
  end
end
